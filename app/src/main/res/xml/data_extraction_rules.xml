<?xml version="1.0" encoding="utf-8"?>
<!--
    SICHERHEIT: Keine App-Daten in Cloud-Backups und keine Übertragung beim Gerätewechsel.
    So landen Reisen, Beträge und Namen nie unverschlüsselt auf fremden Servern.
    (Ein eigenes, verschlüsseltes Backup kommt in Version 2.0.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
